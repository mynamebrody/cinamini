# Supabase Configuration (existing)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# TMDB API (existing)
TMDB_API_KEY=your_tmdb_api_key
TMDB_BASE_URL=https://api.themoviedb.org/3

# Security Configuration (new)
CSRF_SECRET=your_csrf_secret_key_64_chars_long_for_production_use_only
NEXT_PUBLIC_APP_URL=https://cinamini.app

# Optional: Redis URL for distributed rate limiting (future enhancement)
# REDIS_URL=redis://localhost:6379

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-

# Where to send Webhook Events
CINAMINI_GUESS_WEBHOOK_URL=

# UI Feature Flags
# Toggle the global site banner on/off (default: off)
NEXT_PUBLIC_GLOBAL_BANNER_ENABLED=false

# OpenAI API (for smart puzzle generation)
OPENAI_API_KEY=your_openai_api_key
# Model used by the smart puzzle generator and admin fun-facts route.
# Must support OpenAI's Responses API + `web_search` tool.
# Default: gpt-5-mini
OPENAI_PUZZLE_MODEL=gpt-5-mini

IMAGEKIT_PUBLIC_KEY="public_="
IMAGEKIT_PRIVATE_KEY="private_="
NEXT_PUBLIC_IMAGEKIT_URL="https://ik.imagekit.io/cinamini"

